{
 "quire": 1,
 "title": "Engineering modules",
 "cells": [
  {"type": "text", "source": "# Engineering worksheets\nOne worked problem per module. Units are carried through every formula, so a wrong quantity fails instead of silently producing a number."},
  {"type": "text", "source": "## Circuits: an RC low-pass filter"},
  {"type": "math", "source": "R = 4.7 kohm\nC = 100 nF"},
  {"type": "math", "source": "f_c = cutoff(R, C) -> Hz"},
  {"type": "math", "source": "H = rc_lowpass(R, C, s)"},
  {"type": "math", "source": "G(f) = bode_gain(H, s, f)\nphase(f) = bode_phase(H, s, f)"},
  {"type": "plot", "kind": "function", "exprs": "G(f)", "xmin": "1 Hz", "xmax": "100 kHz", "var": "f", "logx": true},
  {"type": "math", "source": "impedance_C(C, f_c) -> ohm"},
  {"type": "text", "source": "## Control: a second-order plant with unity feedback"},
  {"type": "math", "source": "P = tf([4], [1, 2, 4], s)"},
  {"type": "math", "source": "damping(P, s)"},
  {"type": "math", "source": "overshoot(1/2)"},
  {"type": "math", "source": "y(t) = step_response(P, s, t)"},
  {"type": "plot", "kind": "function", "exprs": "y(t)", "xmin": "0", "xmax": "8", "var": "t"},
  {"type": "math", "source": "routh(s^3 + 2 s^2 + 3 s + K, s)"},
  {"type": "text", "source": "## Mechanics: a simply supported beam"},
  {"type": "math", "source": "P_load = 10 kN\nL = 4 m\nE = material_E(steel)\nI = I_rect(50 mm, 150 mm)"},
  {"type": "math", "source": "beam = beam_ss_point(P_load, L, E, I, x)"},
  {"type": "math", "source": "subs(beam[0], x, L/2) -> mm"},
  {"type": "math", "source": "sigma_max = bending_stress(subs(beam[1], x, L/2), 75 mm, I) -> MPa"},
  {"type": "math", "source": "safety_factor(material_yield(steel), sigma_max)"},
  {"type": "plot", "kind": "function", "exprs": "beam[0]", "xmin": "0 m", "xmax": "4 m", "var": "x"},
  {"type": "text", "source": "## Thermo and fluids: water in a pipe"},
  {"type": "math", "source": "T = from_celsius(20)\nrho = fluid_density(water, T, 1 atm)\nmu = fluid_viscosity(water, T, 1 atm)"},
  {"type": "math", "source": "D = 50 mm\nv = 2 m/s\nRe = reynolds(rho, v, D, mu)"},
  {"type": "math", "source": "f_d = friction_factor(Re, 0.001)"},
  {"type": "math", "source": "pressure_drop(f_d, 100 m, D, rho, v) -> kPa"},
  {"type": "math", "source": "to_celsius(saturation_temperature(water, 2 bar))"},
  {"type": "math", "source": "carnot_efficiency(from_celsius(500), from_celsius(25))"},
  {"type": "text", "source": "## Signals: two tones and a filter"},
  {"type": "math", "source": "fs = 1000\nx = sample_signal(sin(2 pi 50 t) + 0.5 sin(2 pi 120 t), t, fs, 0.5)"},
  {"type": "math", "source": "spec = spectrum(x, fs)"},
  {"type": "plot", "kind": "scatter", "exprs": "spec[0]", "expr2": "spec[1]"},
  {"type": "math", "source": "ba = butter(4, 80, fs)\ny_f = filter_apply(ba[0], ba[1], x)\nspec2 = spectrum(y_f, fs)"},
  {"type": "plot", "kind": "scatter", "exprs": "spec2[0]", "expr2": "spec2[1]"},
  {"type": "math", "source": "fourier_partial_sum(t, t, 2 pi, 4)"},
  {"type": "text", "source": "## Chemistry: burning propane"},
  {"type": "math", "source": "balance([C3H8, O2], [CO2, H2O])"},
  {"type": "math", "source": "n_propane = moles(1 kg, C3H8) -> mol"},
  {"type": "math", "source": "mass_of(3 n_propane, CO2) -> kg"},
  {"type": "math", "source": "molar_mass(C3H8)"},
  {"type": "math", "source": "rate_ratio(50 kJ/mol, from_celsius(25), from_celsius(35))"}
 ]
}
