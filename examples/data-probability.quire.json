{
 "quire": 1,
 "title": "Data and probability",
 "cells": [
  {"type": "text", "source": "# Data and probability\nDistributions stay symbolic until you ask for numbers; tests and fits work on plain lists; money follows the time value formulas."},
  {"type": "text", "source": "## Probability\nA normal variable with symbolic parameters, and a Bayesian update for a medical test."},
  {"type": "math", "source": "X = normal(mu, sigma)"},
  {"type": "math", "source": "pdf(X, x)"},
  {"type": "math", "source": "expected(X^2)"},
  {"type": "math", "source": "prob(normal(0, 1) > 1.96)"},
  {"type": "plot", "kind": "function", "exprs": "pdf(normal(0, 1), x), pdf(student_t(3), x)", "xmin": "-4", "xmax": "4", "var": "x"},
  {"type": "math", "source": "prevalence = 0.01\nsensitivity = 0.95\nspecificity = 0.95"},
  {"type": "math", "source": "bayes(prevalence, sensitivity, prevalence sensitivity + (1 - prevalence) (1 - specificity))"},
  {"type": "math", "source": "prob(binomial_dist(10, 1/2) >= 8)"},
  {"type": "text", "source": "## Statistics\nA small sample: interval, test, fit."},
  {"type": "math", "source": "xs = [5.1, 4.9, 5.3, 5.0, 5.2, 5.4, 4.8]"},
  {"type": "math", "source": "describe(xs)"},
  {"type": "math", "source": "confidence_interval(xs, 0.95)"},
  {"type": "math", "source": "t_test(xs, 5)"},
  {"type": "math", "source": "ts = [0, 1, 2, 3, 4]\ny = [1.0, 2.7, 7.4, 20.1, 54.6]"},
  {"type": "math", "source": "model(t) = expfit(ts, y, t)"},
  {"type": "plot", "kind": "scatter", "exprs": "ts", "expr2": "y"},
  {"type": "plot", "kind": "function", "exprs": "model(t)", "xmin": "0", "xmax": "4", "var": "t"},
  {"type": "text", "source": "## Finance\nA mortgage, a project, a bond, an option."},
  {"type": "math", "source": "pmt(0.05/12, 360, 300000)"},
  {"type": "math", "source": "amortization(10000, 0.06/12, 6)"},
  {"type": "math", "source": "npv(0.08, [-1000, 300, 400, 500])\nirr([-1000, 300, 400, 500])"},
  {"type": "math", "source": "bond_price(1000, 0.05, 0.06, 10)\nbond_duration(1000, 0.05, 0.06, 10)"},
  {"type": "math", "source": "black_scholes_call(100, 100, 0.05, 0.2, 1)"},
  {"type": "math", "source": "call(S) = black_scholes_call(S, 100, 0.05, 0.2, 0.5)"},
  {"type": "plot", "kind": "function", "exprs": "call(S), max(S - 100, 0)", "xmin": "60", "xmax": "140", "var": "S"},
  {"type": "text", "source": "## Actuarial\nA Gompertz-Makeham mortality table and a whole-life policy issued at 40."},
  {"type": "math", "source": "q = makeham_qx(110)"},
  {"type": "math", "source": "survival(q, 40, 25)\nlife_expectancy(q, 40)"},
  {"type": "math", "source": "P = net_annual_premium(q, 40, 0.04)"},
  {"type": "math", "source": "reserve(q, 40, 0.04, 10)\nreserve(q, 40, 0.04, 20)"}
 ]
}
